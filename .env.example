# Qloo Hackathon API.
# Header: X-Api-Key. When QLOO_API_KEY is unset, taste-quest serves synthetic sample data.
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com

# Self-hosted OSRM foot server. The base already includes the auth path token,
# for example https://osrm-tq.example.sslip.io/<token>
# Requests go to ${OSRM_BASE_URL}/route/v1/foot/{lon,lat;...}
# When unset, routes use the straight-line "approx." fallback.
OSRM_BASE_URL=

# AI Gateway through the AI SDK. On Vercel it authenticates with the request's OIDC
# token (a header, not an env var), so nothing needs setting there.
# Locally, `vercel env pull` writes a short-lived OIDC token. Do not commit it.
# An AI_GATEWAY_API_KEY is optional and only for local dev off Vercel.
# Leave unset for the defaults. A model with no price in lib/agent/budget.ts is
# refused (AI switches off) rather than undercounted.
# AI_MODEL=google/gemini-2.5-flash
# AI_FALLBACK_MODEL=google/gemini-2.5-flash-lite
# App-side daily AI spend cap in USD (default 0.3, so a month stays under $10).
# AI_DAILY_BUDGET_USD=0.3
# AI_GATEWAY_API_KEY=

# Bearer token for GET /api/health. Cron warmer (not in this slice) checks CRON_SECRET.
ADMIN_TOKEN=
CRON_SECRET=
